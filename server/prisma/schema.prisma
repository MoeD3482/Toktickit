generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestedPriority {
  Low
  Medium
  High
  Urgent
}

enum ITPriority {
  Low
  Medium
  High
  Urgent
}

enum TicketStatus {
  New
  Open
  InProgress
  WaitingForRequester
  Resolved
  Closed
  Reopened
  Cancelled
}

enum UserRole {
  Requester
  ITStaff
  Administrator
}

enum PasswordState {
  InitialPassword
  ChangeRequired
  Active
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model DevelopmentRequester {
  id          String   @id @default(uuid())
  displayName String
  email       String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets Ticket[]
}

model User {
  id            String        @id @default(uuid())
  displayName   String
  email         String        @unique
  passwordHash  String
  roles         UserRole[]    @default([Requester])
  isActive      Boolean       @default(true)
  passwordState PasswordState @default(InitialPassword)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  requestedTickets    Ticket[]        @relation("TicketRequesterUser")
  assignedTickets     Ticket[]        @relation("TicketAssignedStaffUser")
  uploadedAttachments Attachment[]    @relation("AttachmentUploadedByUser")
  removedAttachments  Attachment[]    @relation("AttachmentRemovedByUser")
  ticketComments      TicketComment[]
  internalNotes       InternalNote[]
  ticketActions       TicketAction[]
  actionsTaken        ActionTaken[]   @relation("ActionTakenPerformedBy")
}

model RelatedSystem {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
}

model Ticket {
  id                String            @id @default(uuid())
  ticketNo          String            @unique
  requesterId       String
  requesterUserId   String?
  assignedToUserId  String?
  categoryId        Int
  relatedSystemId   String
  summary           String
  description       String
  requestedPriority RequestedPriority
  itPriority        ITPriority?
  status            TicketStatus      @default(New)
  clientRequestId   String            @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  requester     DevelopmentRequester @relation(fields: [requesterId], references: [id])
  requesterUser User?                @relation("TicketRequesterUser", fields: [requesterUserId], references: [id])
  assignedTo    User?                @relation("TicketAssignedStaffUser", fields: [assignedToUserId], references: [id])
  category      Category             @relation(fields: [categoryId], references: [id])
  relatedSystem RelatedSystem        @relation(fields: [relatedSystemId], references: [id])

  attachments   Attachment[]
  comments      TicketComment[]
  internalNotes InternalNote[]
  actions       TicketAction[]
  actionsTaken  ActionTaken[]

  @@index([requesterId])
  @@index([requesterUserId])
  @@index([assignedToUserId])
  @@index([categoryId])
  @@index([relatedSystemId])
  @@index([requesterId, updatedAt])
  @@index([requesterUserId, updatedAt])
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model InternalNote {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model TicketAction {
  id          String   @id @default(uuid())
  ticketId    String
  actorUserId String
  actionType  String
  body        String
  createdAt   DateTime @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id])
  actorUser User   @relation(fields: [actorUserId], references: [id])

  @@index([ticketId, createdAt])
  @@index([actorUserId])
  @@index([actionType])
}

model ActionTaken {
  id                String   @id @default(uuid())
  ticketId          String
  performedByUserId String
  actionAt          DateTime
  description       String
  result            String
  followUpRequired  Boolean  @default(false)
  followUpNote      String?
  attachmentNotes   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  idempotencyKey     String?  @unique
  requestFingerprint String?

  ticket      Ticket @relation(fields: [ticketId], references: [id])
  performedBy User   @relation("ActionTakenPerformedBy", fields: [performedByUserId], references: [id])

  @@index([ticketId, actionAt])
  @@index([performedByUserId])
}

model Attachment {
  id                    String    @id @default(uuid())
  ticketId              String
  originalFilename      String
  storageKey            String    @unique
  mimeType              String
  sizeBytes             Int
  uploadedByRequesterId String
  uploadedByUserId      String?
  isRemoved             Boolean   @default(false)
  removedAt             DateTime?
  removedByRequesterId  String?
  removedByUserId       String?
  removalReason         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  ticket         Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedByUser User?  @relation("AttachmentUploadedByUser", fields: [uploadedByUserId], references: [id])
  removedByUser  User?  @relation("AttachmentRemovedByUser", fields: [removedByUserId], references: [id])

  @@index([ticketId])
  @@index([ticketId, isRemoved])
  @@index([uploadedByUserId])
  @@index([removedByUserId])
}

model TicketNumberSequence {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}
